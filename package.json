{
	"name": "daily-dash",
	"version": "0.6.0",
	"description": "Daily Dashboard — a warm, modular home surface for Obsidian: clock, verse of the day, agenda, to-dos, journal, meals, shopping, contacts, quotes, search, and an optional AI daily brief.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --import tsx --test src/tests/*.test.ts"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"dashboard",
		"home"
	],
	"author": "SilentNinja06",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"esbuild": "^0.21.5",
		"obsidian": "^1.5.7",
		"tslib": "^2.6.2",
		"tsx": "^4.19.0",
		"typescript": "^5.4.5"
	},
	"dependencies": {
		"dash-core": "github:SilentNinja06/dash_core_obs#bf16c08c6a0110c3c3834c1f9486edd1f93d79b1"
	}
}
