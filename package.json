{
	"name": "daily-dash",
	"version": "0.3.0",
	"description": "Daily Dashboard — a warm, general-purpose home surface for Obsidian: clock, verse of the day, today's agenda, persistent to-dos, journal, meals, and search.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --import tsx --test src/tests/*.test.ts"
	},
	"keywords": ["obsidian", "obsidian-plugin", "dashboard", "home"],
	"author": "SilentNinja06",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"esbuild": "^0.21.5",
		"obsidian": "^1.5.7",
		"tslib": "^2.6.2",
		"tsx": "^4.19.0",
		"typescript": "^5.4.5"
	}
}
